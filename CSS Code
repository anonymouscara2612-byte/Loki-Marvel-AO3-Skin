.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " ⛓️  ";
  color: transparent !important;
  text-shadow: 0 0 0 #DDCEB9;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 90px;
  height: 90px;
  background-image: url("https://64.media.tumblr.com/8d732c1485e9b80a8359451d15843dc2/ae283827040b5a7c-d4/s1280x1920/77135831cec00baed261b43f601e45d4e863c111.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "𝔒𝔥, 𝔲𝔤𝔥. ℑ𝔰 𝔩𝔬𝔳𝔢 𝔯𝔢𝔞𝔩𝔩𝔶 𝔤𝔬𝔦𝔫𝔤 𝔱𝔬 𝔰𝔞𝔳𝔢 𝔲𝔰 𝔞𝔩𝔩?";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(13, 13, 13, 0.7);
  text-align: center;
  font-size: 14px;
  color: #E8F0D8;
  opacity: 1;
  white-space: pre;
}

